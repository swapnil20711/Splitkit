  "license": "MIT",
  "homepage": "https://github.com/swapnil20711/splitkit#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.1.1",
    "babel-preset-expo": "~57.0.7",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^57.0.13",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "prettier": "^3.0.0",
    "react-native": "0.86.2",
    "typescript": "^5.9.2"
  },
